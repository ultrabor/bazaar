--- /dev/null
+++ b/internal/platform/httpx/user_test.go
@@ -0,0 +1,117 @@
+package httpx
+
+import (
+	"bazaar/internal/modules/user"
+	"bazaar/internal/platform/httpx/middleware"
+	"context"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// fakeUserService реализует UserService — хендлер тестируется без базы и без JWT.
+type fakeUserService struct {
+	gotCompanyId string
+	getErr       error
+	created      *user.CreateUserRequest
+	createErr    error
+}
+
+func (f *fakeUserService) GetUserById(_ context.Context, userId, companyId string) (*user.User, error) {
+	f.gotCompanyId = companyId
+	if f.getErr != nil {
+		return nil, f.getErr
+	}
+	return &user.User{Id: userId, CompanyId: companyId, FirstName: "Ali"}, nil
+}
+
+func (f *fakeUserService) CreateUser(_ context.Context, r *user.CreateUserRequest) (*user.CreateUserResponse, error) {
+	f.created = r
+	if f.createErr != nil {
+		return nil, f.createErr
+	}
+	return &user.CreateUserResponse{UserID: "new-user"}, nil
+}
+
+func newTestHandler(svc UserService) *Handler {
+	log := slog.New(slog.NewTextHandler(io.Discard, nil))
+	return New(log, chi.NewRouter(), &ServiceManager{userService: svc})
+}
+
+func withURLParam(r *http.Request, key, value string) *http.Request {
+	rctx := chi.NewRouteContext()
+	rctx.URLParams.Add(key, value)
+	return r.WithContext(context.WithValue(r.Context(), chi.RouteCtxKey, rctx))
+}
+
+func TestGetUserById_UsesCompanyFromCurrentUser(t *testing.T) {
+	svc := &fakeUserService{}
+	h := newTestHandler(svc)
+
+	req := httptest.NewRequest(http.MethodGet, "/user/u-2", nil)
+	req = req.WithContext(middleware.WithCurrentUser(req.Context(), &user.User{Id: "u-1", CompanyId: "company-A"}))
+	req = withURLParam(req, "id", "u-2")
+	rec := httptest.NewRecorder()
+
+	h.GetUserById(rec, req)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200", rec.Code)
+	}
+	if svc.gotCompanyId != "company-A" {
+		t.Fatalf("company = %q, want company of current user", svc.gotCompanyId)
+	}
+}
+
+func TestGetUserById_NotFound(t *testing.T) {
+	h := newTestHandler(&fakeUserService{getErr: user.ErrNotFound})
+
+	req := httptest.NewRequest(http.MethodGet, "/user/u-2", nil)
+	req = req.WithContext(middleware.WithCurrentUser(req.Context(), &user.User{CompanyId: "company-A"}))
+	req = withURLParam(req, "id", "u-2")
+	rec := httptest.NewRecorder()
+
+	h.GetUserById(rec, req)
+
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("status = %d, want 404", rec.Code)
+	}
+}
+
+func TestCreateUser_CompanyComesFromToken_NotBody(t *testing.T) {
+	svc := &fakeUserService{}
+	h := newTestHandler(svc)
+
+	body := `{"first_name":"Ali","phone":"+998901234567","password":"Secret1!","user_role_id":"r-1","company_id":"company-B"}`
+	req := httptest.NewRequest(http.MethodPost, "/user", strings.NewReader(body))
+	req = req.WithContext(middleware.WithCurrentUser(req.Context(), &user.User{CompanyId: "company-A"}))
+	rec := httptest.NewRecorder()
+
+	h.CreateUser(rec, req)
+
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	if svc.created.CompanyId != "company-A" {
+		t.Fatalf("company = %q, want company-A from token", svc.created.CompanyId)
+	}
+}
+
+func TestCreateUser_InvalidRole_400(t *testing.T) {
+	h := newTestHandler(&fakeUserService{createErr: user.ErrInvalidRole})
+
+	req := httptest.NewRequest(http.MethodPost, "/user", strings.NewReader(`{"first_name":"Ali"}`))
+	req = req.WithContext(middleware.WithCurrentUser(req.Context(), &user.User{CompanyId: "company-A"}))
+	rec := httptest.NewRecorder()
+
+	h.CreateUser(rec, req)
+
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want 400", rec.Code)
+	}
+}

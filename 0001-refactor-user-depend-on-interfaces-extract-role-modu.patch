diff --git a/internal/modules/user/service_test.go b/internal/modules/user/service_test.go
new file mode 100644
index 0000000..80bcea5
--- /dev/null
+++ b/internal/modules/user/service_test.go
@@ -0,0 +1,142 @@
+package user
+
+import (
+	"bazaar/internal/modules/role"
+	"bazaar/internal/platform/database"
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+// --- заглушки: каждая реализует интерфейс, от которого зависит Service ---
+
+type fakeTx struct {
+	committed  bool
+	rolledBack bool
+}
+
+func (t *fakeTx) Exec(context.Context, string, ...any) (pgconn.CommandTag, error) {
+	return pgconn.CommandTag{}, nil
+}
+func (t *fakeTx) Query(context.Context, string, ...any) (pgx.Rows, error) { return nil, nil }
+func (t *fakeTx) QueryRow(context.Context, string, ...any) pgx.Row        { return nil }
+func (t *fakeTx) Commit(context.Context) error                            { t.committed = true; return nil }
+func (t *fakeTx) Rollback(context.Context) error {
+	if !t.committed {
+		t.rolledBack = true
+	}
+	return nil
+}
+
+type fakeTxBeginner struct {
+	tx     *fakeTx
+	opened int
+}
+
+func (b *fakeTxBeginner) BeginTx(context.Context) (database.Tx, error) {
+	b.opened++
+	return b.tx, nil
+}
+
+type fakeRepo struct {
+	createErr error
+	createdOn database.Querier
+}
+
+func (r *fakeRepo) GetUserById(context.Context, string, string) (*User, error) { return nil, nil }
+func (r *fakeRepo) CreateUser(_ context.Context, q database.Querier, _ *CreateUserRequest) (*CreateUserResponse, error) {
+	r.createdOn = q
+	if r.createErr != nil {
+		return nil, r.createErr
+	}
+	return &CreateUserResponse{UserID: "user-1"}, nil
+}
+
+type fakeRoles struct {
+	checkErr error
+	giveErr  error
+	givenOn  database.Querier
+	givenTo  string
+}
+
+func (f *fakeRoles) CheckAssignable(context.Context, string, string) error { return f.checkErr }
+func (f *fakeRoles) GivePermissions(_ context.Context, q database.Querier, userId, _ string) error {
+	f.givenOn, f.givenTo = q, userId
+	return f.giveErr
+}
+
+func validRequest() *CreateUserRequest {
+	return &CreateUserRequest{
+		FirstName:  "Ali",
+		Phone:      "+998901234567",
+		Password:   "Secret1!",
+		CompanyId:  "company-1",
+		UserRoleId: "role-1",
+	}
+}
+
+// --- тесты ---
+
+func TestCreateUser_RoleNotAssignable_NoTransaction(t *testing.T) {
+	tx := &fakeTxBeginner{tx: &fakeTx{}}
+	svc := NewService(&fakeRepo{}, tx, &fakeRoles{checkErr: role.ErrNotAssignable})
+
+	_, err := svc.CreateUser(context.Background(), validRequest())
+
+	if !errors.Is(err, ErrInvalidRole) {
+		t.Fatalf("err = %v, want ErrInvalidRole", err)
+	}
+	if tx.opened != 0 {
+		t.Fatalf("transaction opened %d times, want 0", tx.opened)
+	}
+}
+
+func TestCreateUser_Success_SameTransactionAndCommit(t *testing.T) {
+	tx := &fakeTx{}
+	repo := &fakeRepo{}
+	roles := &fakeRoles{}
+	svc := NewService(repo, &fakeTxBeginner{tx: tx}, roles)
+
+	res, err := svc.CreateUser(context.Background(), validRequest())
+
+	if err != nil {
+		t.Fatalf("unexpected err: %v", err)
+	}
+	if res.UserID != "user-1" || roles.givenTo != "user-1" {
+		t.Fatalf("permissions given to %q, want user-1", roles.givenTo)
+	}
+	if repo.createdOn != tx || roles.givenOn != tx {
+		t.Fatal("user and permissions must be written in the same transaction")
+	}
+	if !tx.committed {
+		t.Fatal("transaction not committed")
+	}
+}
+
+func TestCreateUser_GivePermissionsFails_Rollback(t *testing.T) {
+	tx := &fakeTx{}
+	svc := NewService(&fakeRepo{}, &fakeTxBeginner{tx: tx}, &fakeRoles{giveErr: errors.New("db down")})
+
+	_, err := svc.CreateUser(context.Background(), validRequest())
+
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	if tx.committed || !tx.rolledBack {
+		t.Fatalf("committed=%v rolledBack=%v, want rollback without commit", tx.committed, tx.rolledBack)
+	}
+}
+
+func TestCreateUser_PhoneTaken(t *testing.T) {
+	pgErr := &pgconn.PgError{Code: "23505", ConstraintName: "users_active_phone_unique"}
+	svc := NewService(&fakeRepo{createErr: pgErr}, &fakeTxBeginner{tx: &fakeTx{}}, &fakeRoles{})
+
+	_, err := svc.CreateUser(context.Background(), validRequest())
+
+	if !errors.Is(err, ErrPhoneTaken) {
+		t.Fatalf("err = %v, want ErrPhoneTaken", err)
+	}
+}
diff --git a/internal/platform/database/database.go b/internal/platform/database/database.go
index 1e1b483..213ad2b 100644
--- a/internal/platform/database/database.go
+++ b/internal/platform/database/database.go
@@ -9,9 +9,31 @@ import (
 	"time"
 
 	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
 	"github.com/jackc/pgx/v5/pgxpool"
 )
 
+// Querier — то, что умеют и пул соединений, и транзакция.
+// Репозиторий, принимающий Querier, работает и внутри транзакции, и без неё.
+type Querier interface {
+	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
+}
+
+// Tx — транзакция. pgx.Tx подходит под этот интерфейс автоматически,
+// а в тестах её легко подменить маленькой заглушкой.
+type Tx interface {
+	Querier
+	Commit(ctx context.Context) error
+	Rollback(ctx context.Context) error
+}
+
+// TxBeginner открывает транзакцию. Сервисы зависят от него, а не от *Database.
+type TxBeginner interface {
+	BeginTx(ctx context.Context) (Tx, error)
+}
+
 type Database struct {
 	db  *pgxpool.Pool
 	log *slog.Logger
@@ -66,6 +88,10 @@ func (d *Database) Begin(ctx context.Context) (pgx.Tx, error) {
 	return d.db.Begin(ctx)
 }
 
+func (d *Database) BeginTx(ctx context.Context) (Tx, error) {
+	return d.db.Begin(ctx)
+}
+
 func (d *Database) Close() {
 	d.db.Close()
 }

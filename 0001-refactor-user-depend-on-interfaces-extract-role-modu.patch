+package role
+
+import (
+	"bazaar/internal/platform/database"
+	"context"
+	"errors"
+)
+
+// Repo — то, что сервису нужно от хранилища. *Repository подходит под него автоматически.
+type Repo interface {
+	GetById(ctx context.Context, roleId, companyId string) (*Role, error)
+	GivePermissions(ctx context.Context, q database.Querier, userId, roleId string) error
+}
+
+type Service struct {
+	repo Repo
+}
+
+func NewService(repo Repo) *Service {
+	return &Service{repo: repo}
+}
+
+// CheckAssignable — можно ли назначить роль пользователю этой компании.
+// Правило «owner назначать нельзя» живёт здесь, у владельца данных о ролях,
+// а не копируется в каждый модуль, который назначает роль.
+func (s *Service) CheckAssignable(ctx context.Context, roleId, companyId string) error {
+	role, err := s.repo.GetById(ctx, roleId, companyId)
+	if err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return ErrNotAssignable
+		}
+		return err
+	}
+
+	if role.IsSystem {
+		return ErrNotAssignable
+	}
+
+	return nil
+}
+
+func (s *Service) GivePermissions(ctx context.Context, q database.Querier, userId, roleId string) error {
+	return s.repo.GivePermissions(ctx, q, userId, roleId)
+}

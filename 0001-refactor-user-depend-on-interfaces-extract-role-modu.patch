+package httpx
+
+import (
+	"bazaar/internal/modules/user"
+	"context"
+)
+
+// Интерфейсы сервисов, которые нужны хендлерам. Настоящие *Service подходят под них
+// автоматически, а в тестах хендлеров вместо них подставляются заглушки без базы.
+//
+// Остальные модули переводятся так же: интерфейс здесь → поле в ServiceManager → параметр NewServiceManager.
+
+type UserService interface {
+	GetUserById(ctx context.Context, userId, companyId string) (*user.User, error)
+	CreateUser(ctx context.Context, r *user.CreateUserRequest) (*user.CreateUserResponse, error)
+}
diff --git a/internal/platform/httpx/user_test.go b/internal/platform/httpx/user_test.go
new file mode 100644

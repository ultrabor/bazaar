+package role
+
+import "errors"
+
+type Role struct {
+	Id        string `json:"id"`
+	CompanyId string `json:"company_id"`
+	Name      string `json:"name"`
+	IsSystem  bool   `json:"is_system"`
+}
+
+var ErrNotFound = errors.New("role not found")
+
+// ErrNotAssignable — роль чужой компании, архивная или системная (owner).
+var ErrNotAssignable = errors.New("role is not assignable")
diff --git a/internal/modules/role/repository.go b/internal/modules/role/repository.go
new file mode 100644
index 0000000..a8531a9
--- /dev/null
+++ b/internal/modules/role/repository.go
@@ -0,0 +1,51 @@
+package role
+
+import (
+	"bazaar/internal/platform/database"
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+)
+
+type Repository struct {
+	db *database.Database
+}
+
+func NewRepository(db *database.Database) *Repository {
+	return &Repository{db: db}
+}
+
+func (r *Repository) GetById(ctx context.Context, roleId, companyId string) (*Role, error) {
+	var role Role
+
+	err := r.db.GetDB().QueryRow(ctx, `
+		SELECT id, company_id, name, is_system
+		FROM user_roles
+		WHERE id = $1 AND company_id = $2 AND deleted_at = 0
+	`, roleId, companyId).Scan(&role.Id, &role.CompanyId, &role.Name, &role.IsSystem)
+
+	if err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			return nil, ErrNotFound
+		}
+		return nil, err
+	}
+
+	return &role, nil
+}
+
+// GivePermissions копирует пакет роли пользователю.
+// q — пул или транзакция: вызывающий сам решает, в какой транзакции это выполнить.
+func (r *Repository) GivePermissions(ctx context.Context, q database.Querier, userId, roleId string) error {
+	_, err := q.Exec(ctx, `
+		INSERT INTO user_permissions(user_id, permission_id)
+		SELECT $1, rp.permission_id
+		FROM role_permissions rp
+		JOIN permissions p ON p.id = rp.permission_id AND p.deleted_at = 0
+		WHERE rp.user_role_id = $2
+		ON CONFLICT DO NOTHING
+	`, userId, roleId)
+
+	return err
+}

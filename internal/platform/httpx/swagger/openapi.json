{
  "openapi": "3.0.3",
  "info": {
    "title": "Bazaar API",
    "version": "0.1.0",
    "description": "Inventory and sales accounting API"
  },
  "paths": {
    "/auth/register-owner": {
      "post": {
        "summary": "Register a company and its owner",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RegisterRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Company and owner created",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RegisterResponse"}
              }
            }
          },
          "400": {"description": "Invalid request or phone number"},
          "409": {"description": "Phone number is already registered"},
          "500": {"description": "Server error"},
          "503": {"description": "Request timed out"}
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Check service health",
        "tags": ["Health"],
        "responses": {"200": {"description": "Healthy"}}
      }
    },
    "/readyz": {
      "get": {
        "summary": "Check service readiness",
        "tags": ["Health"],
        "responses": {"200": {"description": "Ready"}, "503": {"description": "Not ready"}}
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["first_name", "company_name", "phone", "password"],
        "properties": {
          "first_name": {"type": "string", "example": "Ismoiljon"},
          "last_name": {"type": "string", "example": "Olimjonov"},
          "company_name": {"type": "string", "example": "Bazaar"},
          "phone": {"type": "string", "example": "+998901234567"},
          "password": {"type": "string", "format": "password"}
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "company_id": {"type": "string", "format": "uuid"},
          "user_id": {"type": "string", "format": "uuid"}
        }
      }
    }
  }
}
